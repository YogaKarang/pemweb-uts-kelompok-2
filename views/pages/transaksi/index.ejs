<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title><%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container py-5">
    <h2>Daftar Transaksi Gym</h2>
    <a href="/transaksi/create" class="btn btn-primary mb-3">+ Tambah Transaksi</a>
    
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>ID Member</th>
                <th>ID Paket</th>
                <th>Tanggal</th>
                <th>Metode Bayar</th>
                <th>Total (Rp)</th>
                <th>Status</th>
                <th>Aksi</th>
            </tr>
        </thead>
        <tbody>
            <% if (transaksis && transaksis.length > 0) { %>
                <% transaksis.forEach(trx => { %>
                    <tr>
                        <td><%= trx.id %></td>
                        <td><%= trx.id_member %></td>
                        <td><%= trx.id_paket %></td>
                        <td><%= trx.tanggal_transaksi %></td>
                        <td><%= trx.metode_bayar %></td>
                        <td><%= Number(trx.total_bayar).toLocaleString('id-ID') %></td>
                        <td><%= trx.status_bayar %></td>
                        <td>
                            <a href="/transaksi/edit/<%= trx.id %>" class="btn btn-sm btn-warning">Edit</a>
                            <form action="/transaksi/delete/<%= trx.id %>" method="POST" class="d-inline" onsubmit="return confirm('Yakin ingin menghapus?')">
                                <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="8" class="text-center">Belum ada data transaksi.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</body>
</html>