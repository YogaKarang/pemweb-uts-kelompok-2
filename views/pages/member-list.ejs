<%- include('../partials/header') %>

<!-- Font Awesome CDN untuk Ikon -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<main class="container container-home">
  <!-- Toolbar Header Halaman -->
  <div class="page-toolbar mb-3">
    <div>
      <h2 class="fw-bold text-white mb-1">Data Member</h2>
      <p class="text-muted small mb-0">Kelola daftar seluruh anggota terdaftar GYM FORGE.</p>
    </div>
    <div>
      <a href="/member/tambah" class="btn-hero-primary">
        <i class="fa-solid fa-user-plus"></i> Tambah Member
      </a>
    </div>
  </div>

  <!-- Alert Notifikasi Jika Gagal Hapus -->
  <% if (typeof pesanError !== 'undefined' && pesanError) { %>
    <div class="alert alert--err mb-4">
      <i class="fa-solid fa-circle-exclamation me-2"></i>
      <%= pesanError %>
    </div>
  <% } %>

  <!-- Table Container Dark Glassmorphism -->
  <div class="glass-card p-3">
    <div class="table-wrap">
      <table class="table-custom">
        <thead>
          <tr>
            <th class="text-center" style="width: 50px;">No</th>
            <th>Nama Member</th>
            <th>No. HP</th>
            <th>Email</th>
            <th>Jenis Kelamin</th>
            <th>Tanggal Lahir</th>
            <th class="text-center">Status</th>
            <th class="text-center" style="width: 140px;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof members !== 'undefined' && members && members.length > 0) { %>
            <% members.forEach((m, index) => { %>
              <tr>
                <td class="text-center font-weight-bold" style="color: #94a3b8;"><%= index + 1 %></td>
                <td>
                  <span class="fw-semibold text-white"><%= m.nama_member || m.nama %></span>
                </td>
                <td style="color: #cbd5e1;"><i class="fa-solid fa-phone text-muted me-1 small"></i> <%= m.no_hp || '-' %></td>
                <td style="color: #cbd5e1;"><i class="fa-solid fa-envelope text-muted me-1 small"></i> <%= m.email || '-' %></td>
                <td style="color: #cbd5e1;"><%= m.jenis_kelamin || '-' %></td>
                <td style="color: #cbd5e1;"><%= m.tanggal_lahir ? new Date(m.tanggal_lahir).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : '-' %></td>
                <td class="text-center">
                  <% if (m.status === 'Aktif') { %>
                    <span class="badge-status badge-status--active">Aktif</span>
                  <% } else { %>
                    <span class="badge-status badge-status--inactive">Nonaktif</span>
                  <% } %>
                </td>
                <td class="text-center">
                  <div class="d-flex justify-content-center gap-2">
                    <a href="/member/edit/<%= m.id %>" class="btn-action btn-action--edit" title="Edit Data">
                      <i class="fa-solid fa-pen-to-square"></i> Edit
                    </a>
                    <form action="/member/hapus/<%= m.id %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus member ini?');">
                      <button type="submit" class="btn-action btn-action--delete" title="Hapus Data">
                        <i class="fa-solid fa-trash"></i> Hapus
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center py-4 text-muted">
                <i class="fa-solid fa-users-slash fs-3 d-block mb-2"></i>
                Belum ada data member terdaftar.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>