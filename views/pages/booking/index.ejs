<%- include('../../partials/header') %>

<main class="container">
  <div class="page-head">
    <h1>Booking Latihan</h1>
    <a href="/booking/create" class="btn btn-primary">+ Tambah Booking</a>
  </div>

  <% if (info) { %>
    <div class="alert alert-success"><%= info %></div>
  <% } %>

  <% if (bookings.length === 0) { %>
    <div class="empty-state">
      <p>Belum ada data booking latihan.</p>
      <a href="/booking/create" class="btn btn-primary">Buat booking pertama</a>
    </div>
  <% } else { %>
    <div class="table-wrap" style="overflow-x:auto;">
      <table class="table">
        <thead>
          <tr>
            <th>No</th>
            <th>Member</th>
            <th>Jenis Latihan</th>
            <th>Tanggal</th>
            <th>Jam Mulai</th>
            <th>Status</th>
            <th>Catatan</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% bookings.forEach((b, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= b.nama_member %></td>
              <td><%= b.jenis_latihan %></td>
              <td><%= b.tanggal_tampil %></td>
              <td><%= b.jam_mulai %> WITA</td>
              <td><span class="badge badge-<%= b.status.toLowerCase() %>"><%= b.status %></span></td>
              <td><%= b.catatan || '-' %></td>
              <td class="actions">
                <a href="/booking/<%= b.id %>/edit" class="btn btn-sm">Edit</a>
                <form action="/booking/<%= b.id %>/delete" method="POST"
                      onsubmit="return confirm('Hapus booking ini?');" style="display:inline;">
                  <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

<%- include('../../partials/footer') %>