<%- include('../partials/header', { pageTitle: pageTitle }) %>
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> - Gym Management</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
        }
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
        .table th {
            font-weight: 600;
            color: #495057;
            background-color: #f8f9fa !important;
            border-bottom: 2px solid #dee2e6;
        }
        .table td {
            vertical-align: middle;
            color: #212529;
        }
        .search-container {
            position: relative;
        }
        #clearSearch {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #6c757d;
            display: none;
            z-index: 10;
        }
        #clearSearch:hover {
            color: #dc3545;
        }
        #searchInput {
            padding-right: 35px;
        }
    </style>
</head>
<body>
    <div class="container py-5">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1">Daftar Transaksi Gym</h2>
                <p class="text-muted mb-0">Kelola data transaksi pembayaran member dengan mudah.</p>
            </div>
            <button class="btn btn-primary px-4 py-2 shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#formTambahTransaksi" aria-expanded="false" aria-controls="formTambahTransaksi">
                <i class="fa-solid fa-plus me-2"></i>Tambah Transaksi
            </button>
        </div>

        <div class="collapse mb-4" id="formTambahTransaksi">
            <div class="card card-body p-4 bg-white">
                <h4 class="fw-bold mb-3">Form Tambah Transaksi Baru</h4>
                <form action="/transaksi/store" method="POST" class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Nama Member</label>
                        <input type="text" name="nama_member" class="form-control" placeholder="Ketik nama member..." required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Pilih Paket</label>
                        <select name="id_paket" class="form-select" required>
                            <option value="">-- Pilih Paket --</option>
                            <% if (typeof pakets !== 'undefined' && pakets.length > 0) { %>
                                <% pakets.forEach(function(paket) { %>
                                    <option value="<%= paket.id %>"><%= paket.nama_paket %> (Rp <%= Number(paket.harga).toLocaleString('id-ID') %>)</option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Tanggal Transaksi</label>
                        <input type="date" name="tanggal_transaksi" class="form-control" required>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Metode Pembayaran</label>
                        <select name="metode_bayar" class="form-select" required>
                            <option value="Tunai">Tunai</option>
                            <option value="Transfer">Transfer</option>
                            <option value="QRIS">QRIS</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Status Bayar</label>
                        <select name="status_bayar" class="form-select" required>
                            <option value="Lunas">Lunas</option>
                            <option value="Belum Lunas">Belum Lunas</option>
                        </select>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Total Bayar (Rp)</label>
                        <input type="number" name="total_bayar" class="form-control" placeholder="Contoh: 250000" required>
                    </div>

                    <div class="col-12 text-end">
                        <button type="submit" class="btn btn-success px-4">
                            <i class="fa-solid fa-save me-1"></i> Simpan Transaksi
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div style="width: 300px;" class="search-container">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control" placeholder="Cari nama member...">
                </div>
                <span id="clearSearch" title="Hapus pencarian">
                    <i class="fa-solid fa-xmark"></i>
                </span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small me-2" id="dataCounter">Menampilkan 0 data</span>
                <div>
                    <a href="/transaksi" class="btn btn-outline-secondary btn-sm me-1">Semua Transaksi</a>
                    <a href="/transaksi/qris" class="btn btn-outline-info btn-sm">Filter QRIS</a>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="transaksiTable">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">No</th>
                                <th>Nama Member</th>
                                <th>Jenis Paket</th>
                                <th>Tanggal</th>
                                <th>Metode Bayar</th>
                                <th>Total (Rp)</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (transaksis && transaksis.length > 0) { %>
                                <% transaksis.forEach(function(trx, index) { %>
                                    <tr>
                                        <td class="ps-4 fw-semibold">#<%= index + 1 %></td>
                                        <td class="nama-member"><span class="fw-medium text-dark"><%= trx.nama_member %></span></td>
                                        <!-- Langsung membaca nama paket dari database/join secara dinamis -->
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary px-2 py-1">
                                                <%= trx.nama_paket || 'Paket #' + trx.id_paket %>
                                            </span>
                                        </td>
                                        <td class="text-muted"><%= trx.tanggal_transaksi %></td>
                                        <td><span class="fw-medium"><%= trx.metode_bayar %></span></td>
                                        <td class="fw-semibold text-success">Rp <%= Number(trx.total_bayar).toLocaleString('id-ID') %></td>
                                        <td>
                                            <% if (trx.status_bayar.toLowerCase() === 'lunas') { %>
                                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Lunas</span>
                                            <% } else { %>
                                                <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill">Belum Lunas</span>
                                            <% } %>
                                        </td>
                                        <td class="text-end pe-4">
                                            <button class="btn btn-sm btn-outline-warning me-1 px-3" data-bs-toggle="modal" data-bs-target="#editModal<%= trx.id %>">
                                                <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                                            </button>

                                            <form action="/transaksi/delete/<%= trx.id %>" method="POST" class="d-inline" onsubmit="return confirm('Yakin ingin menghapus data transaksi ini?')">
                                                <button type="submit" class="btn btn-sm btn-outline-danger px-3">
                                                    <i class="fa-solid fa-trash me-1"></i> Hapus
                                                </button>
                                            </form>
                                        </td>
                                    </tr>

                                    <div class="modal fade" id="editModal<%= trx.id %>" tabindex="-1" aria-labelledby="editModalLabel<%= trx.id %>" aria-hidden="true">
                                        <div class="modal-dialog modal-lg">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold" id="editModalLabel<%= trx.id %>">Edit Transaksi #<%= trx.id %></h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form action="/transaksi/update/<%= trx.id %>" method="POST">
                                                    <div class="modal-body text-start">
                                                        <div class="row g-3">
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold">Nama Member</label>
                                                                <input type="text" name="nama_member" class="form-control" value="<%= trx.nama_member %>" required>
                                                            </div>

                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold">Pilih Paket</label>
                                                                <select name="id_paket" class="form-select" required>
                                                                    <option value="">-- Pilih Paket --</option>
                                                                    <% if (typeof pakets !== 'undefined') { %>
                                                                        <% pakets.forEach(function(paket) { %>
                                                                            <option value="<%= paket.id %>" <%= trx.id_paket === paket.id ? 'selected' : '' %>>
                                                                                <%= paket.nama_paket %> (Rp <%= Number(paket.harga).toLocaleString('id-ID') %>)
                                                                            </option>
                                                                        <% }); %>
                                                                    <% } %>
                                                                </select>
                                                            </div>

                                                            <div class="col-md-4">
                                                                <label class="form-label fw-semibold">Tanggal Transaksi</label>
                                                                <input type="date" name="tanggal_transaksi" class="form-control" value="<%= trx.tanggal_transaksi %>" required>
                                                            </div>

                                                            <div class="col-md-4">
                                                                <label class="form-label fw-semibold">Metode Pembayaran</label>
                                                                <select name="metode_bayar" class="form-select" required>
                                                                    <option value="Tunai" <%= trx.metode_bayar === 'Tunai' ? 'selected' : '' %>>Tunai</option>
                                                                    <option value="Transfer" <%= trx.metode_bayar === 'Transfer' ? 'selected' : '' %>>Transfer</option>
                                                                    <option value="QRIS" <%= trx.metode_bayar === 'QRIS' ? 'selected' : '' %>>QRIS</option>
                                                                </select>
                                                            </div>

                                                            <div class="col-md-4">
                                                                <label class="form-label fw-semibold">Status Bayar</label>
                                                                <select name="status_bayar" class="form-select" required>
                                                                    <option value="Lunas" <%= trx.status_bayar === 'Lunas' ? 'selected' : '' %>>Lunas</option>
                                                                    <option value="Belum Lunas" <%= trx.status_bayar === 'Belum Lunas' ? 'selected' : '' %>>Belum Lunas</option>
                                                                </select>
                                                            </div>

                                                            <div class="col-md-12">
                                                                <label class="form-label fw-semibold">Total Bayar (Rp)</label>
                                                                <input type="number" name="total_bayar" class="form-control" value="<%= trx.total_bayar %>" required>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                                                        <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8" class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-folder-open fs-2 mb-2 d-block"></i>
                                        Belum ada data transaksi yang tersedia.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const searchInput = document.getElementById('searchInput');
        const clearSearch = document.getElementById('clearSearch');
        const rows = document.querySelectorAll('#transaksiTable tbody tr');
        const dataCounter = document.getElementById('dataCounter');

        function filterTable() {
            let filter = searchInput.value.toLowerCase();
            let visibleCount = 0;

            rows.forEach(row => {
                let namaMemberEl = row.querySelector('.nama-member');
                if (namaMemberEl) {
                    let textValue = namaMemberEl.textContent || namaMemberEl.innerText;
                    if (textValue.toLowerCase().indexOf(filter) > -1) {
                        row.style.display = "";
                        visibleCount++;
                    } else {
                        row.style.display = "none";
                    }
                }
            });

            if (filter.length > 0) {
                clearSearch.style.display = "block";
            } else {
                clearSearch.style.display = "none";
            }

            dataCounter.textContent = `Menampilkan ${visibleCount} data transaksi`;
        }

        searchInput.addEventListener('keyup', filterTable);

        clearSearch.addEventListener('click', function() {
            searchInput.value = '';
            filterTable();
            searchInput.focus();
        });

        filterTable();
    </script>
</body>
</html>
<%- include('../partials/footer') %>