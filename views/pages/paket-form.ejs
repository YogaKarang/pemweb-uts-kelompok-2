<%- include('../partials/header', { pageTitle: pageTitle }) %>

<div class="card form-card">
  <h2><%= mode === 'edit' ? 'Edit Paket Membership' : 'Tambah Paket Membership' %></h2>

  <% if (errors.length) { %>
    <div class="alert alert--err">
      <ul>
        <% errors.forEach(e => { %><li><%= e %></li><% }) %>
      </ul>
    </div>
  <% } %>

  <form action="<%= mode === 'edit' ? '/paket/edit/' + paket.id : '/paket/tambah' %>" method="POST">

    <label for="nama_paket">Nama Paket</label>
    <input type="text" id="nama_paket" name="nama_paket" maxlength="100" required
           value="<%= paket.nama_paket %>">

    <div class="row">
      <div>
        <label for="durasi_hari">Durasi (hari)</label>
        <input type="number" id="durasi_hari" name="durasi_hari" min="1" step="1" required
               value="<%= paket.durasi_hari %>">
      </div>
      <div>
        <label for="harga">Harga (Rp)</label>
        <input type="number" id="harga" name="harga" min="0" step="any" required
               value="<%= paket.harga %>">
      </div>
    </div>

    <label for="deskripsi">Deskripsi</label>
    <textarea id="deskripsi" name="deskripsi" rows="3"><%= paket.deskripsi || '' %></textarea>

    <label for="status">Status</label>
    <select id="status" name="status">
      <option value="Aktif"    <%= paket.status === 'Aktif' ? 'selected' : '' %>>Aktif</option>
      <option value="Nonaktif" <%= paket.status === 'Nonaktif' ? 'selected' : '' %>>Nonaktif</option>
    </select>

    <div class="actions">
      <button type="submit" class="btn">Simpan</button>
      <a class="cancel" href="/paket">Batal</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>