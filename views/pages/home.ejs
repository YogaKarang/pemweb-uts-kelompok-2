<%- include('../partials/header') %>

<!-- Font Awesome CDN untuk Ikon -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<main class="container container-home">
  <!-- Hero Banner Utama -->
  <div class="hero-banner">
    <div class="row align-items-center">
      <div class="col-lg-9">
        <h1>
          Selamat Datang di <span class="text-gradient-brand">GYM FORGE</span>
        </h1>
        <p>
          Kelola sistem keanggotaan member, variasi paket kebugaran, rekaman transaksi pembayaran, hingga reservasi booking latihan dalam satu platform terpadu.
        </p>
        <div class="hero-action-group">
          <a href="/booking/create" class="btn-hero-primary">
            <i class="fa-solid fa-plus"></i> Booking Latihan Baru
          </a>
          <a href="/member" class="btn-hero-secondary">
            <i class="fa-solid fa-users-gear"></i> Kelola Member
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Cards Ringkasan Statistik -->
  <div class="home-grid-4">
    <div class="glass-card stat-card">
      <div>
        <span class="stat-title">Member Aktif</span>
        <h3 class="stat-value"><%= stats.totalMember %></h3>
      </div>
      <div class="icon-glow glow-cyan">
        <i class="fa-solid fa-users"></i>
      </div>
    </div>

    <div class="glass-card stat-card">
      <div>
        <span class="stat-title">Paket Latihan</span>
        <h3 class="stat-value"><%= stats.totalPaket %></h3>
      </div>
      <div class="icon-glow glow-emerald">
        <i class="fa-solid fa-dumbbell"></i>
      </div>
    </div>

    <div class="glass-card stat-card">
      <div>
        <span class="stat-title">Transaksi Lunas</span>
        <h3 class="stat-value"><%= stats.totalTransaksi %></h3>
      </div>
      <div class="icon-glow glow-amber">
        <i class="fa-solid fa-receipt"></i>
      </div>
    </div>

    <div class="glass-card stat-card">
      <div>
        <span class="stat-title">Booking Dipesan</span>
        <h3 class="stat-value"><%= stats.totalBooking %></h3>
      </div>
      <div class="icon-glow glow-purple">
        <i class="fa-solid fa-calendar-check"></i>
      </div>
    </div>
  </div>

  <!-- Navigasi Akses Cepat Modul Fitur -->
  <h5 class="fw-bold mb-3 text-white d-flex align-items-center gap-2">
    <i class="fa-solid fa-cubes text-info"></i> Akses Cepat Modul Fitur
  </h5>

  <div class="home-grid-4">
    <a href="/member" class="glass-card feature-card card-cyan">
      <div class="icon-glow glow-cyan">
        <i class="fa-solid fa-id-card"></i>
      </div>
      <h6>Modul Member</h6>
      <p>Manajemen pendaftaran & data keanggotaan gym.</p>
    </a>

    <a href="/paket" class="glass-card feature-card card-emerald">
      <div class="icon-glow glow-emerald">
        <i class="fa-solid fa-box-archive"></i>
      </div>
      <h6>Modul Paket</h6>
      <p>Kelola pilihan durasi dan harga paket keanggotaan.</p>
    </a>

    <a href="/transaksi" class="glass-card feature-card card-amber">
      <div class="icon-glow glow-amber">
        <i class="fa-solid fa-money-bill-transfer"></i>
      </div>
      <h6>Modul Transaksi</h6>
      <p>Catat transaksi pembayaran via Tunai, Transfer & QRIS.</p>
    </a>

    <a href="/booking" class="glass-card feature-card card-purple">
      <div class="icon-glow glow-purple">
        <i class="fa-solid fa-clock-rotate-left"></i>
      </div>
      <h6>Modul Booking</h6>
      <p>Penjadwalan sesi latihan Gym Bebas, Yoga, Trainer, dll.</p>
    </a>
  </div>
</main>

<%- include('../partials/footer') %>